# Copia este archivo a .env y completa los valores reales
SECRET_KEY=tu_clave_secreta_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=tu_base_de_datos
DB_USER=root
DB_PASSWORD=tu_password
# Ojo: *.railway.internal solo resuelve dentro de Railway.
# Desde Vercel hay que usar el endpoint publico del proxy TCP
# (containers-*.railway.app y su puerto) con DB_SSL=True.
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_SSL=False
