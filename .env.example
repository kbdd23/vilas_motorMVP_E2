# Copia este archivo a .env y completa los valores reales
SECRET_KEY=tu_clave_secreta_aqui
# DEBUG=True solo para desarrollo local. En Vercel debe quedar en False o ausente:
# con True se muestran tracebacks y variables locales con credenciales.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos gestionada en Aiven (MySQL 8.4).
# El puerto público del cluster exige TLS, por eso DB_SSL=True.
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=tu_password
DB_HOST=mysql-17f9cadc-vilasmotor-cluster.l.aivencloud.com
DB_PORT=26785
DB_SSL=True
